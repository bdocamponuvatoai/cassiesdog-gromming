# Canonical production URL. Leave blank in private previews to prevent indexing.
NEXT_PUBLIC_SITE_URL=
# Resend API key and a verified sending-domain address
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
# Cassie's verified destination inbox
BOOKING_TO_EMAIL=
# Upstash Redis REST credentials, required for distributed spam protection
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A random secret of at least 32 bytes (openssl rand -hex 32)
RATE_LIMIT_SECRET=
